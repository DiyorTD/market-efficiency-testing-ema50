#  Forex Market Efficiency Test using Random Walk Hypothesis
#  EMA50 Predictability — CHFJPY Example

import MetaTrader5 as mt5
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.tsa.stattools import adfuller, kpss
import matplotlib.pyplot as plt
import os


